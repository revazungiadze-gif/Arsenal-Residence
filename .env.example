# ── სიარემი მობილური — გარემოს ცვლადები ─────────────────────────────────
# დააკოპირე ეს ფაილი `.env`-ად და ჩაწერე რეალური მნიშვნელობები.
# EXPO_PUBLIC_ პრეფიქსი აუცილებელია — მის გარეშე Expo ცვლადს ვერ ხედავს.
# ⚠️ .env გითში არ აიტვირთება (.gitignore-შია). anon key public-ია, მაგრამ
#    service_role key აქ არასდროს ჩაწერო — ის მხოლოდ სერვერისთვისაა.

# რომელი კომპანია გაეშვას (default: arsenal)
EXPO_PUBLIC_TENANT=arsenal

# ── არსენალი (პილოტი) — არსებული Supabase პროექტი ───────────────────────
EXPO_PUBLIC_ARSENAL_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_ARSENAL_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── ახალი კომპანიის დამატებისას (მაგალითი) ──────────────────────────────
# EXPO_PUBLIC_COMPANYB_SUPABASE_URL=https://companyb.supabase.co
# EXPO_PUBLIC_COMPANYB_SUPABASE_ANON_KEY=eyJhbGciOi...
